# Use allowlist approach - ignore everything by default
*

# Only include what's needed for the runtime
!src/
!src/grpc/
!src/runtime/**
!src/grpc/**
!src/utils/**
!src/utils_rs/**
!src/ddb/**
!src/eval/**
!src/physics/**
!src/controller/**
!src/tools/**
!src/plugins/**
!src/driver/**
!src/wizard/**
!plugins/internal/**
!plugins/transfuser_driver/**
!plugins/mtgs/**
!e2e_challenge/
!e2e_challenge/starter_kit/
!e2e_challenge/starter_kit/**
!pyproject.toml

# Exclude specific runtime directories/files we don't need
src/runtime/build.env
src/runtime/test_output
**/.venv
**/*.egg-info
**/__pycache__
**/.pytest_cache
**/dist
**/build
**/.mypy_cache
**/runs
**/outputs

# Local sample-driver model assets are not needed by the trusted simulation image.
e2e_challenge/sample_submission_vavam/assets/vavam/VAM_width_1024_pretrained_139k.pt
e2e_challenge/sample_submission_vavam/assets/vavam/VQ_ds16_16384_llamagen_encoder.jit
e2e_challenge/sample_submission_simscale_navsim_transfuser/assets/ltf/ltf_sim_navtest.ckpt
